{
  "name": "martech-events-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "MarTech event pipeline MVP built with NestJS, NATS JetStream, PostgreSQL, and TypeORM.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/entrypoints/api.main.js",
    "start:dev": "nest start --watch",
    "start:api": "node dist/entrypoints/api.main.js",
    "start:worker": "node dist/entrypoints/worker.main.js",
    "start:reports": "node dist/entrypoints/reports.main.js",
    "start:api:dev": "nest start --watch --entryFile entrypoints/api.main",
    "start:worker:dev": "nest start --watch --entryFile entrypoints/worker.main",
    "start:reports:dev": "nest start --watch --entryFile entrypoints/reports.main",
    "dev:publisher:start": "docker compose start publisher",
    "dev:publisher:stop": "docker compose stop publisher",
    "dev:publisher:restart": "docker compose restart publisher",
    "typeorm": "typeorm -d dist/persistence/typeorm.datasource.js",
    "migration:run:compiled": "npm run typeorm -- migration:run",
    "migration:run": "npm run build && npm run typeorm -- migration:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "joi": "^17.13.3",
    "nats": "^2.29.2",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.24",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.6",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.11",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
