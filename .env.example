NODE_ENV=development
PORT=3000
WORKER_PORT=3002
REPORTS_PORT=3001
DATABASE_URL=postgres://postgres:postgres@postgres:5432/martech_events
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=EVENTS
NATS_INGEST_SUBJECT=events.ingest.v1
NATS_DLQ_SUBJECT=events.dlq.v1
NATS_DURABLE_NAME=events-db-writer-v1
NATS_STREAM_MAX_AGE_HOURS=24
NATS_CONSUMER_ACK_WAIT_MS=60000
# Defaults to WORKER_CONCURRENCY * WORKER_BATCH_SIZE if unset.
# NATS_CONSUMER_MAX_ACK_PENDING=1000
WEBHOOK_PUBLISH_CONCURRENCY=50
WORKER_CONCURRENCY=10
WORKER_BATCH_SIZE=100
WORKER_BATCH_FLUSH_MS=100
LOG_LEVEL=debug
READINESS_ENABLED=true
EVENT_ENDPOINT=http://api:3000/webhook
